# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed origins, or "*" to reflect any origin.
# Leave unset to keep the default (any origin in dev, http://localhost:5173 otherwise).
# CORS_ORIGIN=http://localhost:5173
# Set to 1 (or the number of proxy hops) when running behind nginx/a load balancer.
TRUST_PROXY=false

# Database
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
# Schema strategy:
#   auto   (default) run pending migrations, then a non-destructive sync
#   sync   legacy behaviour: sequelize.sync({ alter: true }) in dev
#   manual only verify; warn when migrations are pending
DB_MIGRATE=auto
# For PostgreSQL cloud:
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=clinic_db
# DB_USER=clinic_user
# DB_PASS=your-password

# Auth
JWT_SECRET=change-this-to-a-secure-secret
JWT_REFRESH_SECRET=change-this-to-another-secure-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=900000

# App
CLINIC_NAME=Eye Examination Clinic
DEFAULT_LANGUAGE=ar
DEFAULT_CURRENCY=USD

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Backup
BACKUP_DIR=./backups
BACKUP_SCHEDULE_DAYS=7

# Scheduled jobs
# Set to false to run an API-only instance with no background jobs.
SCHEDULER_ENABLED=true
# Lock driver used to keep jobs single-runner. "db" works for SQLite and PostgreSQL.
SCHEDULER_LOCK_DRIVER=db
SCHEDULER_LOCK_TTL_MS=600000

# Password recovery
# Path to the server-side recovery token file (Layer 2 of admin password recovery).
# Only used when the admin requests recovery from localhost.
RECOVERY_TOKEN_PATH=./data/recovery-token.txt

# WhatsApp Cloud API (Layer 1 of message cascade — free up to 1000 conversations/month)
WHATSAPP_CLOUD_API_VERSION=v18.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=

# Telegram Bot (Layer 2 of message cascade — 100% free, no limits)
# Create a bot via @BotFather in Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_POLLING_ENABLED=true

# SMSMobileAPI (Layer 3 of message cascade — local Android phone as SMS gateway)
# Install the SMSMobileAPI app on an Android phone on the same network.
SMS_MOBILE_API_URL=
SMS_MOBILE_API_API_KEY=
SMS_MOBILE_API_ENABLED=false
